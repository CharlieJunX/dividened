# Local: defaults to ../my-stock-agent-starter/.env, or use --env-file.
# GitHub Actions: register these names as repository Actions Secrets.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Korean dividends: apply for 금융위원회_주식배당정보 on data.go.kr.
# Use the decoded service key (percent-encoded keys are also accepted).
DATA_GO_KR_SERVICE_KEY=
# OpenDART authentication key (https://opendart.fss.or.kr/)
OPENDART_API_KEY=

# SEC automated access: organization/project and a real contact email.
SEC_USER_AGENT=

